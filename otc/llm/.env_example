# LLM endpoint (OpenAI-compatible)
LLM_BASE_URL=http://host.docker.internal:8181/v1
LLM_API_KEY=YOUR_LLM_API_KEY_OR_EMPTY
LLM_MODEL_ID=qwen/qwen3-14b

# Model profile selection from configs/models.yaml
OTC_MODEL_KEY=qwen3_14b
OTC_LABELING_MODEL_KEY=qwen3_14b

# Optional OpenAI profile (only needed if you use an OpenAI model key)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# MLflow (disabled by default)
OTC_ENABLE_MLFLOW=false
MLFLOW_TRACKING_URI=file:/app/mlruns
MLFLOW_EXPERIMENT_NAME=otc-llm-experiment

# Example alternative local model profile
# OTC_MODEL_KEY=qwen3-32b-awq
# OTC_LABELING_MODEL_KEY=qwen3-32b-awq
# LLM_MODEL_ID=Qwen3-32B-AWQ
